# Left out of release tarballs, which community-scripts.org and other packagers
# install from. The git repository and install.sh keep everything.
# The workflows, tests, fuzzers and security documents stay in the tarball:
# OpenSSF Scorecard analyses the tarball (without .github it finds no
# workflows), and packagers can run the tests from it.
/FleetPilotAndroid export-ignore
/FleetPilotCS export-ignore
/docs/screenshots export-ignore
/docs/user-guides export-ignore
/demo export-ignore

*.sh text eol=lf
scripts/* text eol=lf
