# FleetPilot configuration. Copy to .env and adjust.

# Signs sessions and encrypts stored credentials. Leave empty to have FleetPilot
# generate one in the data directory, or set your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First admin account. Leave the password empty to have FleetPilot generate one
# and write it to <data dir>/initial_admin_password on first start.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# CSRF protection for forms and browser requests. Keep this on.
WTF_CSRF_ENABLED=true

# Only needed when two FleetPilot instances replicate data (data_sync.py).
# Use the same random value of at least 32 characters on both.
# SYNC_TOKEN=

# Flask debug mode (keep false outside local development)
FLASK_DEBUG=false
