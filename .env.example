# FleetPilot configuration. Copy to .env and adjust.

# Signs sessions and encrypts stored credentials. Leave empty to have FleetPilot
# generate one in the data directory, or set your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First admin account. Leave the password empty to have FleetPilot generate one
# and write it to <data dir>/initial_admin_password on first start.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# CSRF protection for forms and browser requests. Keep this on.
WTF_CSRF_ENABLED=true

# Only needed when two FleetPilot instances replicate data (data_sync.py).
# Use the same random value of at least 32 characters on both.
# SYNC_TOKEN=
# The peer's HTTPS certificate is checked. For a self-signed peer, point this at its
# certificate (or a CA bundle); FLEETPILOT_SYNC_VERIFY=false turns the check off.
# FLEETPILOT_SYNC_CA=/etc/fleetpilot/peer.pem

# Flask debug mode (keep false outside local development)
FLASK_DEBUG=false

# ── High-security sites (see SECURITY.md → "High-security deployment") ──────
# Only FIPS 140-3 approved algorithms for password storage (PBKDF2-HMAC-SHA256).
# FLEETPILOT_FIPS=true
# Refuse SSH servers whose host key is not already in known_hosts.
# FLEETPILOT_SSH_STRICT_HOST_KEYS=true
# Air-gapped networks: no update checks and no online plugin catalogue.
# FLEETPILOT_OFFLINE=true
